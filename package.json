{
  "name": "tw-color-shades",
  "version": "2.0.0",
  "description": "Generate a Tailwind v4 OKLCH color ramp (50-950) from any hex, rgb, hsl or oklch color, with gamut mapping and anchor control.",
  "type": "module",
  "main": "./dist/core.js",
  "types": "./dist/core.d.ts",
  "bin": {
    "tw-color-shades": "./dist/cli.js",
    "twcs": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbparvezme/tw-color-shades.git"
  },
  "bugs": {
    "url": "https://github.com/mbparvezme/tw-color-shades/issues"
  },
  "homepage": "https://github.com/mbparvezme/tw-color-shades#readme",
  "author": "M B Parvez",
  "license": "MIT",
  "keywords": [
    "tailwindcss",
    "tailwind",
    "tailwind-v4",
    "tailwind-plugin",
    "oklch",
    "color",
    "palette",
    "shades",
    "color-scale",
    "design-tokens",
    "gamut-mapping",
    "p3"
  ],
  "dependencies": {
    "culori": "^4.0.1"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/culori": "^4.0.0",
    "@types/node": "^20.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}